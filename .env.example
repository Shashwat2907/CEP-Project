# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never expose to browser

# Email (for OTP codes in production — use Resend, Brevo, or college SMTP)
EMAIL_FROM=
RESEND_API_KEY=

# LiveKit (video calls)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Gemini AI (flashcards, doubt chat)
GEMINI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development convenience: print OTP codes to console instead of sending email
# Set to "true" ONLY in local dev; never in production or preview
DEV_PRINT_OTP_TO_CONSOLE=true
